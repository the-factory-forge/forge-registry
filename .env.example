# Consumer host reference for Support issue linkage: docs/supports-github.md.
# The registry showroom uses in-memory data and does not consume these variables.
# These names follow forge-template; confirm the consuming host's environment schema.

# Forge-owned repositories use SUPPORT_GITHUB_OWNER=the-factory-forge.
# Keep the whole GitHub group empty until configured; setting only the owner fails closed.
# All App, installation, repository and bot IDs, keys and secrets are customer-specific.
SUPPORT_GITHUB_APP_ID=
SUPPORT_GITHUB_PRIVATE_KEY=
SUPPORT_GITHUB_INSTALLATION_ID=
SUPPORT_GITHUB_REPOSITORY_ID=
SUPPORT_GITHUB_BOT_USER_ID=
SUPPORT_GITHUB_OWNER=
SUPPORT_GITHUB_REPOSITORY=
SUPPORT_GITHUB_WEBHOOK_SECRET=
SUPPORT_MAINTENANCE_SECRET=
