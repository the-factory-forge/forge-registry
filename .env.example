# Consumer host reference for Support issue linkage: docs/supports-github.md.
# The registry showroom uses in-memory data and does not consume these variables.
# These names follow forge-template; confirm the consuming host's environment schema.

# The owner is fixed to the-factory-forge; an empty repository override uses SITE_NAME.
# Shared public defaults do not enable delivery; complete the site-specific fields below.
# The Corner Support App ID is 5774442; its key belongs only on the central service.
SUPPORT_GITHUB_TOKEN_URL=https://support.the-corner.swiss/api/token
SUPPORT_GITHUB_SERVICE_TOKEN=
# Existing dedicated Apps only; leave these empty for the shared service.
SUPPORT_GITHUB_APP_ID=
SUPPORT_GITHUB_PRIVATE_KEY=
SUPPORT_GITHUB_INSTALLATION_ID=
SUPPORT_GITHUB_REPOSITORY_ID=
# Shared App bot; override when using a legacy dedicated App.
SUPPORT_GITHUB_BOT_USER_ID=357095502
SUPPORT_GITHUB_REPOSITORY=
SUPPORT_GITHUB_WEBHOOK_SECRET=
SUPPORT_MAINTENANCE_SECRET=
