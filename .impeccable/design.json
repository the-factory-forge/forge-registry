      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary plugin action.",
      "html": "<button class=\"ds-button ds-primary\">Save changes</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;min-height:40px;gap:8px;border:0;border-radius:6px;padding:0 12px;font:500 14px/20px var(--font-sans);cursor:pointer}.ds-button:focus-visible{outline:2px solid var(--ring);outline-offset:2px}.ds-button:disabled{opacity:.5;cursor:not-allowed;pointer-events:none}.ds-primary{background:var(--primary);color:var(--primary-foreground)}.ds-primary:hover{background:color-mix(in srgb,var(--primary) 90%,transparent)}@media(min-width:48rem){.ds-button{min-height:32px}}"
    },
