      "kind": "button",
      "refersTo": "button-outline",
      "description": "Secondary plugin action.",
      "html": "<button class=\"ds-button ds-outline\">Cancel</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;min-height:40px;gap:8px;border:0;border-radius:6px;padding:0 12px;font:500 14px/20px var(--font-sans);cursor:pointer}.ds-button:focus-visible{outline:2px solid var(--ring);outline-offset:2px}.ds-button:disabled{opacity:.5;cursor:not-allowed;pointer-events:none}.ds-outline{border:1px solid var(--border);background:transparent;color:var(--foreground)}.ds-outline:hover{background:var(--accent);color:var(--accent-foreground)}@media(min-width:48rem){.ds-button{min-height:32px}}"
    },
