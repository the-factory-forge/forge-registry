      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;min-height:40px;gap:8px;border:0;border-radius:6px;padding:0 12px;font:500 14px/20px var(--font-sans);cursor:pointer}.ds-button:focus-visible{outline:2px solid var(--ring);outline-offset:2px}.ds-button:disabled{opacity:.5;cursor:not-allowed;pointer-events:none}.ds-icon{width:40px;height:40px;min-height:40px;padding:0;border:1px solid var(--border);background:var(--background);color:var(--foreground)}.ds-icon:hover{background:var(--accent);color:var(--accent-foreground)}@media(min-width:48rem){.ds-button{min-height:32px}}@media(min-width:48rem){.ds-icon{width:32px;height:32px;min-height:32px}}"
