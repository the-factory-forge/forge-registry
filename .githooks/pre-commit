#!/bin/sh
set -eu

# Build from the same registry source that will be committed.
if ! git diff --quiet -- registry/ ||
  [ -n "$(git ls-files --others --exclude-standard -- registry/)" ]; then
  echo "Commit blocked: stage or stash all registry/ changes before checking generated files." >&2
  exit 1
fi

if ! pnpm registry:sync; then
  echo "Commit blocked: pnpm registry:sync failed. Fix the error and retry." >&2
  exit 1
fi

# Compare with the index so already-staged generated updates can pass.
if ! git diff --quiet -- public/r/ ||
  [ -n "$(git ls-files --others --exclude-standard -- public/r/)" ]; then
  echo "Commit blocked: generated registry files differ from the staged files." >&2
  git diff --name-only -- public/r/ >&2
  git ls-files --others --exclude-standard -- public/r/ >&2
  echo "Review the regenerated files, run git add public/r, then retry the commit." >&2
  exit 1
fi
