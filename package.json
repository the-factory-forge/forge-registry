{
  "name": "forge-registry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "fix": "vp check --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "registry:check": "node -e \"JSON.parse(require('node:fs').readFileSync('registry/registry.json','utf8')); console.log('registry/registry.json is valid JSON')\"",
    "registry:sync": "shadcn build registry/registry.json --output public/r",
    "test:browser": "node --test tests/*.browser.mjs",
    "test:storage": "node --test tests/drive-storage/storage.integration.mjs",
    "test:blogs-storage": "node --test tests/blogs-storage/storage.integration.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1133.0",
    "@aws-sdk/s3-request-presigner": "3.1133.0",
    "@base-ui/react": "1.7.0",
    "@tanstack/markdown": "0.0.15",
    "cnfast": "0.1.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.23.0",
    "motion": "12.42.2",
    "next": "16.2.9",
    "postgres": "3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint-plugin-react-hooks": "7.1.1",
    "playwright": "1.62.1",
    "shadcn": "4.19.1",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3",
    "vite-plus": "0.3.0"
  },
  "packageManager": "pnpm@11.20.0"
}
