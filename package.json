{
  "name": "forge-registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "test ! -e .git || git config core.hooksPath .githooks",
    "dev": "portless run vp dev",
    "build": "vp build",
    "start": "node .output/server/index.mjs",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "fix": "vp check --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "registry:check": "node -e \"JSON.parse(require('node:fs').readFileSync('registry/registry.json','utf8')); console.log('registry/registry.json is valid JSON')\"",
    "registry:sync": "shadcn build registry/registry.json --output public/r",
    "test:browser": "node --test tests/*.browser.mjs",
    "test:deployment": "node --test tests/deployment.smoke.mjs",
    "test:storage": "node --test tests/drive-storage/storage.integration.mjs",
    "test:blogs-storage": "node --test tests/blogs-storage/storage.integration.mjs",
    "test:menus-storage": "node --test tests/menus-storage/storage.integration.mjs",
    "preview": "vp preview",
    "test:reservations-storage": "node --test tests/reservations-storage/storage.integration.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1133.0",
    "@aws-sdk/s3-request-presigner": "3.1133.0",
    "@base-ui/react": "1.8.0",
    "@fullcalendar/react": "7.1.0",
    "@tanstack/markdown": "0.0.15",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "better-auth": "1.7.2",
    "cnfast": "0.1.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.49.0",
    "motion": "12.42.2",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "temporal-polyfill": "1.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "nitro": "3.0.260903-beta",
    "playwright": "1.63.0",
    "portless": "0.15.7",
    "shadcn": "4.21.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.8.1"
}
